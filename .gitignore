# Environment — uv manages this, never commit it
.venv/

# uv.lock IS committed. It's what makes the environment reproducible.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Data and artifacts — never commit these
data/
datasets/
*.pt
*.pth
*.ckpt
artifacts/
runs/

# Keep empty directory structure
!**/.gitkeep

# OS
.DS_Store

# Secrets
.env

# Note: .vscode/settings.json is intentionally tracked — it's already in the repo
# and keeps the interpreter path consistent.